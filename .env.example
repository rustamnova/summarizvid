# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=

# xAI (Grok) API key — https://console.x.ai/
# Used as primary summarization model
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# OpenAI API key — https://platform.openai.com/
# Used as fallback when Grok is unavailable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone.
USER_IDS=

# Preferred subtitle languages (comma-separated, e.g. ru,en)
TRANSCRIPT_LANGS=ru,en

# Summary output language (e.g. ru, en, de)
SUMMARY_LANG=ru

# Max comments to analyze (default: 80)
MAX_COMMENTS=80
